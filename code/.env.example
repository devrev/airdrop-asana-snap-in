DEV_ORG=my-org
USER_EMAIL=my@email.com
# ENV=dev | qa | prod (default)

# Only required if using OAuth authentication to run npm run create-keyring
ASANA_CLIENT_ID=your-asana-client-id
ASANA_CLIENT_SECRET=your-asana-client-secret

# Required for mock data generation (npm run generate-mock-data)
ASANA_PAT=your-asana-personal-access-token
# Optional: defaults to first workspace returned by API
# ASANA_WORKSPACE_ID=your-workspace-gid