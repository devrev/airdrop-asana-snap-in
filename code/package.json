{
  "name": "airdrop-asana-snap-in-internal",
  "version": "1.0.0",
  "description": "DevRev Asana Connector",
  "main": "./dist/index.js",
  "scripts": {
    "deploy": "./scripts/deploy.sh",
    "cleanup": "./scripts/cleanup.sh",
    "create-keyring": "./scripts/create-keyring.sh",
    "start": "ts-node ./src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "package": "npm run build && tar -cvzf build.tar.gz dist package.json package-lock.json .npmrc",
    "test": "jest",
    "test:server": "nodemon --watch src --watch test test/main.ts",
    "api-gen": "npx @openapitools/openapi-generator-cli generate -i https://raw.githubusercontent.com/Asana/openapi/refs/heads/master/defs/asana_oas.yaml -g typescript-axios -o src/asana/api-client/generated --skip-validate-spec",
    "generate-mock-data": "ts-node scripts/generate-mock-data/index.ts",
    "cleanup-mock-data": "ts-node scripts/generate-mock-data/index.ts --cleanup"
  },
  "keywords": [
    "asana",
    "devrev",
    "snap-in"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.13.0",
    "@types/yargs": "^17.0.24",
    "body-parser": "^1.20.3",
    "dotenv": "^16.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "express": "^4.21.0",
    "globals": "^15.0.0",
    "jest": "^29.4.2",
    "nodemon": "^3.1.0",
    "prettier": "^2.8.3",
    "prettier-plugin-organize-imports": "^3.2.2",
    "rimraf": "^4.1.2",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.0.0",
    "yargs": "^17.6.2"
  },
  "dependencies": {
    "@devrev/ts-adaas": "1.19.4",
    "axios": "^1.16.1",
    "axios-retry": "4.5.0",
    "form-data": "4.0.5"
  }
}
