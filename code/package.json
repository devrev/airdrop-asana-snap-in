{
  "name": "airdrop-asana-snap-in-internal",
  "version": "1.0.0",
  "description": "DevRev Asana Connector",
  "main": "./dist/index.js",
  "scripts": {
    "deploy": "./scripts/deploy.sh",
    "cleanup": "./scripts/cleanup.sh",
    "create-keyring": "./scripts/create-keyring.sh",
    "start": "ts-node ./src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "package": "npm run build && tar -cvzf build.tar.gz dist package.json package-lock.json .npmrc",
    "test": "jest",
    "test:server": "AIRSYNC_LOCAL_DEVELOPMENT=1 nodemon --watch src --watch test test/main.ts",
    "test:scenario": "npm run build && AIRDROP_EXTERNAL_API_MOCK=\"${AIRDROP_EXTERNAL_API_MOCK:-${EXTERNAL_API_MOCK_BIN:-$(command -v airdrop-external-api-mock)}}\" npx --yes --package=\"${AIRDROP_TEST_RUNNER_ROOT:-../../airdrop-snap-in-mock-dependencies}\" airdrop-extraction-test --fixtures ./fixtures --connector-root . --output-root \"${AIRDROP_TEST_OUTPUT_ROOT:-/tmp/airdrop-asana-tests}\"",
    "test:fixture": "npm run test:scenario -- airdrop_framework_mock",
    "test:orchestration": "npm run test:scenario -- airdrop_framework_mock_orchestration",
    "test:live-assertions": "npm run test:scenario -- airdrop_framework_live_assertions",
    "api-gen": "npx @openapitools/openapi-generator-cli generate -i https://raw.githubusercontent.com/Asana/openapi/refs/heads/master/defs/asana_oas.yaml -g typescript-axios -o src/asana/api-client/generated --skip-validate-spec",
    "generate-mock-data": "ts-node scripts/generate-mock-data/index.ts",
    "cleanup-mock-data": "ts-node scripts/generate-mock-data/index.ts --cleanup"
  },
  "keywords": [
    "asana",
    "devrev",
    "snap-in"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@devrev/typescript-sdk": "1.1.78",
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "^18.13.0",
    "@types/yargs": "^17.0.24",
    "body-parser": "^1.20.6",
    "dotenv": "^16.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "express": "^4.22.2",
    "globals": "^15.0.0",
    "jest": "30.5.2",
    "nodemon": "^3.1.0",
    "prettier": "^2.8.3",
    "prettier-plugin-organize-imports": "^3.2.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.0.0",
    "yargs": "^17.6.2"
  },
  "dependencies": {
    "@devrev/airsync-sdk": "2.0.0",
    "axios": "1.20.0",
    "axios-retry": "4.5.0",
    "form-data": "4.0.6",
    "protobufjs": "7.6.6"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "get-uri": {
      "basic-ftp": "^6.2.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
