diff --git a/v2/db/transaction.go b/v2/db/transaction.go
index 868f255..5ffd0d3 100644
--- a/v2/db/transaction.go
+++ b/v2/db/transaction.go
@@ -6,13 +6,32 @@ package db
 
 import (
 	"context"
+	"errors"
 
 	"go.mongodb.org/mongo-driver/mongo"
+	"google.golang.org/grpc/status"
 
 	"github.com/devrev/airdrop-recipe-manager/client/common"
 	"github.com/devrev/shared/go/errors/types"
 )
 
+type mongoWriteConflictError struct {
+	types.ExternalErrorIfc
+	cause error
+}
+
+func (e *mongoWriteConflictError) Unwrap() error {
+	return e.cause
+}
+
+func (e *mongoWriteConflictError) Is(target error) bool {
+	return errors.Is(e.ExternalErrorIfc, target)
+}
+
+func (e *mongoWriteConflictError) GRPCStatus() *status.Status {
+	return status.New(e.ToGRPCErrorCode(), e.Msg())
+}
+
 func (db *mongoDb) startSession() (mongo.Session, error) {
 	return db.Client.GetMongoClient().StartSession()
 }
