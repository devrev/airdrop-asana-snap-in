@@ -0,0 +1,78 @@
+package db
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.mongodb.org/mongo-driver/bson"
+	"go.mongodb.org/mongo-driver/mongo"
+	"go.mongodb.org/mongo-driver/mongo/integration/mtest"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/devrev/airdrop-recipe-manager/client/common"
+)
+
+func TestWriteConflictRetriesTransaction(t *testing.T) {
+	mt := mtest.New(t, mtest.NewOptions().ClientType(mtest.Mock))
+	mt.Run("transient conflict retries the complete transaction", func(mt *mtest.T) {
+		mt.AddMockResponses(
+			mtest.CreateCommandErrorResponse(mtest.CommandError{Code: 112, Name: "WriteConflict", Message: "write conflict", Labels: []string{"TransientTransactionError"}}),
+			mtest.CreateSuccessResponse(),
+			mtest.CreateSuccessResponse(bson.E{Key: "value", Value: bson.D{{Key: "version", Value: 1}}}),
+			mtest.CreateSuccessResponse(),
+		)
+		session, err := mt.Client.StartSession()
+		require.NoError(mt, err)
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		defer session.EndSession(ctx)
+
+		attempts := 0
+		_, err = session.WithTransaction(ctx, func(ctx mongo.SessionContext) (any, error) {
+			attempts++
+			result := mt.Coll.FindOneAndUpdate(ctx, bson.M{"_id": "pack"}, bson.M{"$inc": bson.M{"version": 1}})
+			return nil, conflictOrInternalError(ctx, result.Err(), "Failed to increment system pack version")
+		})
+		require.NoError(mt, err)
+		require.Equal(mt, 2, attempts)
+
+		commands := []string{}
+		for event := mt.GetStartedEvent(); event != nil; event = mt.GetStartedEvent() {
+			commands = append(commands, event.CommandName)
+		}
+		require.Equal(mt, []string{"findAndModify", "abortTransaction", "findAndModify", "commitTransaction"}, commands)
+	})
+}
+
+func TestWriteConflictWithoutTransientLabelDoesNotRetry(t *testing.T) {
+	mt := mtest.New(t, mtest.NewOptions().ClientType(mtest.Mock))
+	mt.Run("unlabeled conflict returns to caller", func(mt *mtest.T) {
+		mt.AddMockResponses(
+			mtest.CreateCommandErrorResponse(mtest.CommandError{Code: 112, Name: "WriteConflict", Message: "write conflict"}),
+			mtest.CreateSuccessResponse(),
+		)
+		session, err := mt.Client.StartSession()
+		require.NoError(mt, err)
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		defer session.EndSession(ctx)
+
+		attempts := 0
+		_, err = session.WithTransaction(ctx, func(ctx mongo.SessionContext) (any, error) {
+			attempts++
+			result := mt.Coll.FindOneAndUpdate(ctx, bson.M{"_id": "pack"}, bson.M{"$inc": bson.M{"version": 1}})
+			return nil, conflictOrInternalError(ctx, result.Err(), "Failed to increment system pack version")
+		})
+		require.Error(mt, err)
+		require.Contains(mt, err.Error(), "Mongodb write conflict error")
+		require.Equal(mt, codes.Aborted, status.Code(err))
+		require.ErrorIs(mt, err, common.ErrWithCode(codes.Aborted, ""))
+		var cause mongo.CommandError
+		require.ErrorAs(mt, err, &cause)
+		require.Equal(mt, int32(112), cause.Code)
+		require.Equal(mt, 1, attempts)
+	})
+}
